# ==============================================================================
# Environment Configuration Template for DGD Benchmark Runner
# Copy this file to .env and fill in your API keys (Free Tiers Supported)
# ==============================================================================

# Groq API Keys (Fast LPU inference for Qwen-3.8, GPT-OSS-20B/120B)
# Get free keys at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_API_KEY_2=gsk_optional_backup_key_2
GROQ_API_KEY_3=gsk_optional_backup_key_3

# Mistral AI API Keys (Free Tier for Mistral-NeMo 12B)
# Get free keys at: https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_API_KEY_2=your_mistral_backup_key_2
MISTRAL_API_KEY_3=your_mistral_backup_key_3

# Google Gemini API Key (Gemini 2.0 / 3.6 Flash Free Tier)
# Get free keys at: https://aistudio.google.com
GOOGLE_API_KEY=your_google_api_key_here

# OpenRouter Standby API Key
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
